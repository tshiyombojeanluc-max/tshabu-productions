# Supabase project settings — find these in your Supabase project at
# Project Settings → API. Copy this file to .env.local and fill in your
# project's real values; .env.local is already gitignored.
#
# Both of these are safe to expose to the browser (hence NEXT_PUBLIC_) —
# they identify which Supabase project to talk to, not a credential. Actual
# access control is enforced by Row Level Security in the database, not by
# keeping these secret. The service role key (Project Settings → API) is
# NOT used anywhere in this app and should never be added here or committed.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Resend — powers the contact form's email notification (resend.com).
# Server-only: never prefix this with NEXT_PUBLIC_, it must stay off the
# browser. Every contact form submission is saved as a lead in the
# database regardless of whether this is set — this only controls the
# "you've got mail" notification on top of that.
RESEND_API_KEY=your-resend-api-key

# Optional. Defaults to Resend's shared sandbox sender, which works
# immediately but looks less professional and has lower sending limits.
# Once you verify your own domain in Resend, set this to something like:
# CONTACT_FROM_EMAIL="Tshabu Productions <hello@tshabuproductions.com>"
CONTACT_FROM_EMAIL=
