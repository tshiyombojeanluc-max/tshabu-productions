# Supabase project settings — find these in your Supabase project at
# Project Settings → API. Copy this file to .env.local and fill in your
# project's real values; .env.local is already gitignored.
#
# Both of these are safe to expose to the browser (hence NEXT_PUBLIC_) —
# they identify which Supabase project to talk to, not a credential. Actual
# access control is enforced by Row Level Security in the database, not by
# keeping these secret. The service role key (Project Settings → API) is
# NOT used anywhere in this app and should never be added here or committed.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
